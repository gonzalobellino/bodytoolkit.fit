# Premium / payments: set to "true" when your payment processor is live and subscriptions are available
VITE_PREMIUM_PAYMENTS_ENABLED=false

# About page certification badges (set to "false" to hide)
# VITE_SHOW_TPI_LEVEL1_BADGE=true
# VITE_SHOW_TPI_LEVEL2_BADGE=true

# Notify-me form (Vercel API + Resend): receive signups when payments are not yet live
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# From address for form results. With onboarding@resend.dev you can only send to your own email. To send to any coach: verify your domain at https://resend.com/domains and set this (e.g. "Body Toolkit <noreply@bodytoolkit.fit>").
# RESEND_FROM_EMAIL=Body Toolkit <noreply@bodytoolkit.fit>
# Email where you receive "notify me" signups
NOTIFY_ME_TO_EMAIL=coach@example.com
# Contact email for mailto links in the app (footer, contact page). Use the same value as NOTIFY_ME_TO_EMAIL.
VITE_CONTACT_EMAIL=coach@example.com
