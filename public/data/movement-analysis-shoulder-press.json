{
  "name": { "en": "One-Arm Shoulder Press Movement Analysis", "es": "One-Arm Shoulder Press Movement Analysis" },
  "type": "form",
  "domain": "Upper Body",
  "description": { "en": "Movement pattern assessment for unilateral shoulder press exercise", "es": "Movement pattern assessment for unilateral shoulder press exercise" },
  "sections": [
    {
      "title": { "en": "Client Information", "es": "Client Information" },
      "questions": [
        { "id": "oasma_client", "type": "text", "label": { "en": "Client name", "es": "Client name" } },
        { "id": "oasma_date", "type": "date", "label": { "en": "Date", "es": "Date" }, "default": "today" }
      ]
    },
    {
      "title": { "en": "Critical Movement Events", "es": "Critical Movement Events" },
      "questions": [
        { "id": "oasma_event1", "type": "yes_no", "label": { "en": "Critical event #1: Maintenance of posture - Was this event met?", "es": "Critical event #1: Maintenance of posture - Was this event met?" } },
        { "id": "oasma_event2", "type": "yes_no", "label": { "en": "Critical event #2: Elbow extension through a full range of motion - Was this event met?", "es": "Critical event #2: Elbow extension through a full range of motion - Was this event met?" } },
        { "id": "oasma_event3", "type": "yes_no", "label": { "en": "Critical event #3: Glenohumeral joint abduction/adduction through a full range of motion - Was this event met?", "es": "Critical event #3: Glenohumeral joint abduction/adduction through a full range of motion - Was this event met?" } },
        { "id": "oasma_event4", "type": "yes_no", "label": { "en": "Critical event #4: Scapulothoracic region upward/downward rotation through a full range of motion - Was this event met?", "es": "Critical event #4: Scapulothoracic region upward/downward rotation through a full range of motion - Was this event met?" } }
      ]
    },
    {
      "title": { "en": "Sagittal", "es": "Sagittal" },
      "questions": [
        {
          "id": "oasma_observed_sagittal",
          "type": "multi_select",
          "label": { "en": "Sagittal plane observations", "es": "Sagittal plane observations" },
          "options": [
            { "value": "excessive_forward_head", "label": { "en": "Excessive forward head posture", "es": "Excessive forward head posture" } },
            { "value": "thoracic_kyphosis", "label": { "en": "Thoracic kyphosis", "es": "Thoracic kyphosis" } },
            { "value": "inadequate_shoulder_flexion", "label": { "en": "Inadequate shoulder flexion", "es": "Inadequate shoulder flexion" } },
            { "value": "lumbar_hyperextension", "label": { "en": "Lumbar hyperextension", "es": "Lumbar hyperextension" } },
            { "value": "compensatory_trunk_extension", "label": { "en": "Compensatory trunk extension", "es": "Compensatory trunk extension" } },
            { "value": "other", "label": { "en": "Other", "es": "Other" } }
          ]
        }
      ]
    },
    {
      "title": { "en": "Frontal", "es": "Frontal" },
      "questions": [
        {
          "id": "oasma_observed_frontal",
          "type": "multi_select",
          "label": { "en": "Frontal plane observations", "es": "Frontal plane observations" },
          "options": [
            { "value": "shoulder_elevation", "label": { "en": "Shoulder elevation", "es": "Shoulder elevation" } },
            { "value": "asymmetric_shoulder_height", "label": { "en": "Asymmetric shoulder height", "es": "Asymmetric shoulder height" } },
            { "value": "lateral_trunk_lean", "label": { "en": "Lateral trunk lean", "es": "Lateral trunk lean" } },
            { "value": "scapular_winging", "label": { "en": "Scapular winging", "es": "Scapular winging" } },
            { "value": "scapular_tilt", "label": { "en": "Scapular tilt", "es": "Scapular tilt" } },
            { "value": "other", "label": { "en": "Other", "es": "Other" } }
          ]
        }
      ]
    },
    {
      "title": { "en": "Transverse", "es": "Transverse" },
      "questions": [
        {
          "id": "oasma_observed_transverse",
          "type": "multi_select",
          "label": { "en": "Transverse plane observations", "es": "Transverse plane observations" },
          "options": [
            { "value": "shoulder_internal_rotation", "label": { "en": "Shoulder internal rotation", "es": "Shoulder internal rotation" } },
            { "value": "scapular_protraction", "label": { "en": "Scapular protraction", "es": "Scapular protraction" } },
            { "value": "trunk_rotation", "label": { "en": "Trunk rotation", "es": "Trunk rotation" } },
            { "value": "asymmetric_movement", "label": { "en": "Asymmetric movement", "es": "Asymmetric movement" } },
            { "value": "scapular_dyskinesis", "label": { "en": "Scapular dyskinesis", "es": "Scapular dyskinesis" } },
            { "value": "other", "label": { "en": "Other", "es": "Other" } }
          ]
        }
      ]
    },
    {
      "title": { "en": "Additional Notes", "es": "Additional Notes" },
      "questions": [
        { "id": "oasma_notes", "type": "textarea", "label": { "en": "Additional notes and observations", "es": "Additional notes and observations" } }
      ]
    }
  ]
}
